# AI-Powered Website Link Analysis - Environment Variables
# Copy this file to .env and fill in your own credentials.
# NEVER commit real API keys to version control.

# LLM API Credentials (only the provider you use is required)
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# LLM Configuration
# Providers: openai | gemini | anthropic | mock
LLM_PROVIDER=mock
LLM_MODEL=gpt-4o-mini
USE_MOCK_LLM=true
LLM_MAX_RETRIES=1

# Website Extractor Configuration
MAX_CONTENT_CHARS=12000
MAX_TOTAL_CHARS=20000
REQUEST_TIMEOUT=20
MAX_REDIRECTS=5
MAX_PAGES_PER_SITE=3
USER_AGENT=AI-Link-Analysis/1.0

# Cache Configuration
CACHE_ENABLED=true
CACHE_TTL_SECONDS=86400
CACHE_DIR=.cache

# Server Configuration
HOST=0.0.0.0
PORT=4000
